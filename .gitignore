node_modules/
dist/
release/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.env
.env.local
*.sqlite
*.sqlite-journal

# Bundled asset libraries — too large for git (portraits alone ~850MB as WebP).
# The app needs public/assets to build; sources live outside the repo:
# WebP library generated by scripts/convert-portraits.js from the PNG masters
# archived at D:/PROJECT/portrait-master-png (see README.md).
public/assets/*
# ...but the tiny build-required splash image ships with the fork so a fresh
# clone builds without hunting for the art installer (the heavy library lives
# in "DynastyOS Assets/" at the repo root).
!public/assets/splash/

# Local archives / reference material, not source
.backup/
References/
Dynasty Save Test/

# Scratch. `output/` in particular is NOT app output — it's a drop folder that
# has collected unrelated documents, and a blanket `git add -A` committed a
# client invoice out of it once. Ignored so that cannot happen again.
output/
tmp/

# Machine-local Claude Code settings
.claude/settings.local.json

# Generated user manual (regenerate with `npm run manual` from docs/manual/)
# Globbed rather than named: the file is titled after the app, which the
# DynastyOS rename changed once already.
docs/manual/*.pdf
docs/manual/manual.rendered.html

# Throwaway HTML used to eyeball a component in a browser mid-build.
.*-preview.html

{
  "name": "dynastyos",
  "version": "4.3.2",
  "description": "DynastyOS — desktop dynasty tracker for EA Sports College Football 27",
  "author": "InnerActivity Inc.",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "webpack --mode=development",
    "build:clean": "npm run clean && npm run build",
    "build:prod": "webpack --mode=production",
    "start": "npm run build && electron .",
    "package": "npm run clean && npm run build:prod && electron-builder",
    "package:assets": "node build/compile-assets-installer.js",
    "typecheck": "tsc --noEmit",
    "check:refs": "node scripts/check-references.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "manual": "electron docs/manual/make-manual-pdf.js",
    "package:polos": "node build/compile-assets-installer.js polos-installer.nsi"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "electron-updater": "^6.8.9",
    "madden-franchise": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sql.js": "^1.11.0",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.4.45",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
